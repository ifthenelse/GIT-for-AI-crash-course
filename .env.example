# Local defaults. Copy to .env; never add real secrets to Git.
APP_ORIGIN=http://127.0.0.1:5173
ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
PORT=8787
DATABASE_PATH=.tmp/progress.sqlite
# Vite exposes VITE_* values to everyone. Only a public API URL belongs here.
VITE_API_URL=
# PUBLIC_BASE_PATH=/repository-name/
# SITE_URL=https://your-account.github.io/repository-name/
# GitHub appears only when all three backend settings are configured.
# AUTH_SECRET=replace-locally-with-a-strong-random-secret
# GITHUB_CLIENT_ID=your-registered-oauth-client-id
# GITHUB_CLIENT_SECRET=your-oauth-client-secret
# NODE_ENV=production disables the development-only mock login.
